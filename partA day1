def normalize_isbn(value: str) -> str:
    """Validate ISBN-10/13 and return ISBN-13 for API lookup/storage."""
    text = re.sub(r"(?i)^ISBN(?:-1[03])?\s*:?\s*", "", str(value).strip())
    digits = re.sub(r"[\s-]", "", text).upper()
    if len(digits) == 10 and re.fullmatch(r"[0-9]{9}[0-9X]", digits):
        check = 10 if digits[-1] == "X" else int(digits[-1])
        if (sum((10 - index) * int(digit) for index, digit in enumerate(digits[:9])) + check) % 11:
            raise ValueError("ISBN-10のチェック数字が正しくありません。")
        core = "978" + digits[:9]
        check13 = (10 - sum(int(digit) * (1 if index % 2 == 0 else 3) for index, digit in enumerate(core)) % 10) % 10
        return core + str(check13)
    if len(digits) != 13 or not digits.isascii() or not digits.isdigit():
        raise ValueError("ISBNは10桁または13桁の数字で入力してください。")
    if not digits.startswith(("978", "979")):
        raise ValueError("ISBN-13は978または979で始まる必要があります。")
    expected = (10 - sum(int(digit) * (1 if index % 2 == 0 else 3) for index, digit in enumerate(digits[:12])) % 10) % 10
    if expected != int(digits[-1]):
        raise ValueError("ISBN-13のチェック数字が正しくありません。")
    return digits


def analyze_isbn_digits(isbn: str) -> dict[str, Any]:
    normalized = normalize_isbn(isbn)
    group_length = 1 if normalized.startswith(("9780", "9781", "9782", "9783", "9784", "9785", "9787", "9798")) else 0
    group = normalized[3] if group_length else None
    group_labels = {"0": "英語圏", "1": "英語圏", "2": "フランス語圏", "3": "ドイツ語圏", "4": "日本", "5": "ロシア語圏", "7": "中国語圏", "8": "英語圏"}
    return {
        "isbn": normalized, "prefix": normalized[:3], "registration_group": group,
        "registration_group_label": group_labels.get(group),
        "publisher_and_publication_digits": normalized[3 + group_length:-1] if group else None,
        "check_digit": normalized[-1],
    }


def format_isbn_digit_analysis(analysis: dict[str, Any]) -> str:
    parts = [f"接頭部 {analysis.get('prefix')}"]
    if analysis.get("registration_group"):
        parts.extend([
            f"登録グループ {analysis['registration_group']}（{analysis['registration_group_label']}）",
            f"出版者・書名記号 {analysis['publisher_and_publication_digits']}（区切りは可変）",
        ])
    else:
        parts.append("登録グループ・出版者記号の境界は特定できません")
    parts.append(f"チェック数字 {analysis.get('check_digit')}")
    return " / ".join(parts)


def classify_ccode(ccode: str) -> dict[str, Any]:
    """Decode the four digits of a Japanese C-code using the supplied table."""
    code = re.sub(r"\s+", "", str(ccode)).upper()
    if code.startswith("C"):
        code = code[1:]
    if not re.fullmatch(r"\d{4}", code):
        raise ValueError("Cコードは4桁の数字で指定してください。")
    content_code = code[2:]
    return {
        "ccode": code, "audience_code": code[0], "audience_label": C_CODE_AUDIENCES.get(code[0]),
        "format_code": code[1], "format_label": C_CODE_FORMATS.get(code[1]),
        "major_code": code[2], "major_label": C_CODE_MAIN_CATEGORIES.get(code[2]),
        "content_code": content_code, "content_label": C_CODE_CONTENTS.get(content_code),
        "minor_code": code[3], "is_reserved_content_code": content_code not in C_CODE_CONTENTS,
    }


def format_book_classification(classification: dict[str, Any] | None) -> str:
    if not classification:
        return ""
    parts = []
    for digit, code_key, label_key in (
        ("1桁目 販売対象", "audience_code", "audience_label"),
        ("2桁目 発行形態", "format_code", "format_label"),
        ("3桁目 大分類", "major_code", "major_label"),
        ("4桁目 中分類", "minor_code", "content_label"),
    ):
        code, label = classification.get(code_key), classification.get(label_key)
        if code is not None:
            parts.append(f"{digit}: {label or '不明'}（{code}）")
    if not classification.get("content_label") and classification.get("content_code"):
        parts.append("表の未定義・予約コード" if classification.get("is_reserved_content_code") else f"内容コード {classification['content_code']}")
    for key, label in (("ccode", "Cコード"), ("genre_code", "openBDジャンルコード"),
                       ("trc_genre_code", "TRCジャンルコード"), ("ndc_code", "NDC")):
        if classification.get(key):
            parts.append(f"{label} {classification[key]}")
    parts.extend(classification.get("subject_headings") or [])
    return " / ".join(parts)


def search_openlibrary_cover(isbn: str) -> str | None:
    """Return a cover URL only when Open Library reports a thumbnail for the ISBN."""
    query = urlencode({"bibkeys": f"ISBN:{isbn}", "jscmd": "data", "format": "json"})
    request = Request(
        f"https://openlibrary.org/api/books?{query}",
        headers={"User-Agent": "ContentRecordApp/1.0"},
    )
    try:
        with urlopen(request, timeout=8) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (HTTPError, URLError, TimeoutError, OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    book = payload.get(f"ISBN:{isbn}") if isinstance(payload, dict) else None
    cover = book.get("thumbnail_url") if isinstance(book, dict) else None
    return str(cover) if cover else None


def search_openbd_book(isbn_value: str) -> dict[str, Any]:
    isbn = normalize_isbn(isbn_value)
    request = Request(
        f"https://api.openbd.jp/v1/get?{urlencode({'isbn': isbn})}",
        headers={"User-Agent": "ContentRecordApp/1.0"},
    )
    try:
        with urlopen(request, timeout=10) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (HTTPError, URLError, TimeoutError, OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("openBD APIに接続できませんでした。時間をおいて再試行してください。") from exc
    item = payload[0] if isinstance(payload, list) and payload else None
    if not isinstance(item, dict):
        fallback_cover = search_openlibrary_cover(isbn)
        if fallback_cover:
            return {
                "isbn": isbn, "title": None, "author": None, "publisher": None,
                "cover": fallback_cover, "pages": None, "classification": {},
                "isbn_analysis": analyze_isbn_digits(isbn), "suggested_category": "book",
                "cover_source": "Open Library",
            }
        raise ValueError("このISBNの書誌情報はopenBDに見つかりませんでした。")

    onix = item.get("onix") or {}
    detail = onix.get("DescriptiveDetail") or {}
    publishing = onix.get("PublishingDetail") or {}
    summary = item.get("summary") or {}
    hanmoto = item.get("hanmoto") or {}
    title_element = ((detail.get("TitleDetail") or {}).get("TitleElement") or {})
    title = summary.get("title") or ((title_element.get("TitleText") or {}).get("content"))
    contributors = detail.get("Contributor") or []
    authors = [((contributor.get("PersonName") or {}).get("content")) for contributor in contributors if isinstance(contributor, dict)]
    author = summary.get("author") or "、".join(name for name in authors if name) or None

    ccode = genre_code = None
    headings = []
    for subject in detail.get("Subject") or []:
        if not isinstance(subject, dict):
            continue
        scheme = str(subject.get("SubjectSchemeIdentifier", ""))
        code = str(subject.get("SubjectCode", "")).strip()
        if subject.get("SubjectHeadingText"):
            headings.append(str(subject["SubjectHeadingText"]))
        if scheme == "78":
            ccode = code or None
        elif scheme == "79":
            genre_code = code or None
    try:
        classification = classify_ccode(ccode) if ccode else {}
    except ValueError:
        classification = {"ccode": ccode}
    classification.update({
        "genre_code": genre_code,
        "trc_genre_code": str(hanmoto.get("genrecodetrc")) if hanmoto.get("genrecodetrc") else None,
        "ndc_code": str(hanmoto.get("ndccode")).strip() if hanmoto.get("ndccode") else None,
        "subject_headings": headings,
    })
    pages = None
    for item_extent in detail.get("Extent") or []:
        if isinstance(item_extent, dict) and item_extent.get("ExtentType") == "11":
            try:
                pages = int(item_extent.get("ExtentValue"))
            except (TypeError, ValueError):
                pass
            break
    imprint = ((publishing.get("Imprint") or {}).get("ImprintName"))
    publisher_info = ((publishing.get("Publisher") or {}).get("PublisherName"))
    cover = summary.get("cover") or search_openlibrary_cover(isbn)
    return {
        "isbn": isbn, "title": title, "author": author,
        "publisher": summary.get("publisher") or imprint or publisher_info,
        "cover": cover, "cover_source": "openBD" if summary.get("cover") else "Open Library" if cover else None,
        "pages": pages,
        "classification": classification, "isbn_analysis": analyze_isbn_digits(isbn),
        "suggested_category": "manga" if classification.get("format_code") == "9" else "book",
    }

