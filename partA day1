def _ensure_data_file() -> None:
    DATA_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not DATA_FILE.exists():
        DATA_FILE.write_text(
            json.dumps(SAMPLE_RECORDS, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )


def load_records() -> list[dict[str, Any]]:
    _ensure_data_file()
    with DATA_FILE.open("r", encoding="utf-8") as file:
        records = json.load(file)
    if not isinstance(records, list):
        raise ValueError("記録データの形式が正しくありません。")
    return records


def get_record(record_id: str) -> dict[str, Any] | None:
    return next((record for record in load_records() if record.get("id") == record_id), None)


def _validate_record(record: dict[str, Any]) -> None:
    title = record.get("title")
    if not isinstance(title, str) or not title.strip():
        raise ValueError("タイトルを入力してください。")

    category = record.get("category")
    if not isinstance(category, str) or category not in CATEGORY_LABELS:
        raise ValueError("カテゴリを選択してください。")

    completed_at = record.get("completed_at")
    try:
        if isinstance(completed_at, datetime):
            completed_date = completed_at.date()
        elif isinstance(completed_at, date):
            completed_date = completed_at
        else:
            completed_date = date.fromisoformat(str(completed_at))
    except (TypeError, ValueError):
        raise ValueError("完了日を入力してください。") from None
    if completed_date > datetime.now(JST).date():
        raise ValueError("完了日に未来の日付は指定できません。")

    metrics = record.get("metrics", {})
    if not isinstance(metrics, dict):
        raise ValueError("量の入力形式が正しくありません。")
    if set(metrics) - ALLOWED_METRICS[category]:
        raise ValueError("このカテゴリでは入力できない量が含まれています。")
    for value in metrics.values():
        if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:
            raise ValueError("量は1以上の数値を入力してください。")
    if category == "manga" and not any(metrics.get(key) is not None for key in ("pages", "volumes")):
        raise ValueError("漫画はページ数または巻数のどちらかを入力してください。")


def add_record(record: dict[str, Any]) -> str:
    if not isinstance(record, dict):
        raise ValueError("記録データの形式が正しくありません。")
    _validate_record(record)
    records = load_records()
    saved_record = deepcopy(record)
    record_id = str(uuid4())
    now = datetime.now(JST).isoformat(timespec="seconds")
    saved_record.update({"id": record_id, "created_at": now, "updated_at": now})
    records.append(saved_record)
    DATA_FILE.write_text(json.dumps(records, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return record_id


def delete_record(record_id: str) -> bool:
    records = load_records()
    remaining = [record for record in records if record.get("id") != record_id]
    if len(remaining) == len(records):
        return False
    DATA_FILE.write_text(json.dumps(remaining, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return True


def format_metrics(record: dict[str, Any]) -> str:
    metrics = record.get("metrics") or {}
    category = record.get("category")
    pages = metrics.get("pages")
    volumes = metrics.get("volumes")

    if category == "book":
        return f"{pages}ページ" if pages else ""
    if category == "manga":
        parts = []
        if volumes:
            parts.append(f"{volumes}巻")
        if pages:
            parts.append(f"{pages}ページ")
        return "/".join(parts)
    if category == "movie":
        duration = metrics.get("duration_minutes")
        return f"{duration}分" if duration else ""
    if category in {"anime", "drama"}:
        episodes = metrics.get("episodes")
        minutes = metrics.get("minutes_per_episode")
        if episodes and minutes:
            return f"{episodes}話×{minutes}分"
        return f"{episodes}話" if episodes else ""
    return ""


def render_cover(record: dict[str, Any], width: int = 120) -> None:
    image_info = record.get("image") or {}
    image_type = image_info.get("type")
    image_value = image_info.get("value")
    if image_type in {"url", "upload"} and image_value:
        try:
            st.image(image_value, width=width)
            return
        except (OSError, RuntimeError, TypeError, ValueError):
            pass
    icon = CATEGORY_ICONS.get(record.get("category"), CATEGORY_ICONS["other"])
    st.markdown(f"## {icon}")


def render_record_card(record: dict[str, Any]) -> None:
    with st.container(border=True):
        cover_col, detail_col = st.columns([1, 3])
        with cover_col:
            render_cover(record)
        with detail_col:
            st.subheader(record.get("title") or "（タイトルなし）")
            category = record.get("category", "other")
            st.caption(CATEGORY_LABELS.get(category, "その他"))
            if record.get("creator"):
                st.write(f"作者・監督など: {record['creator']}")
            if record.get("isbn"):
                st.caption(f"ISBN: {record['isbn']}")
                if record.get("isbn_analysis"):
                    st.caption(format_isbn_digit_analysis(record["isbn_analysis"]))
                classification = format_book_classification(record.get("book_classification"))
                if classification:
                    st.write(f"分類: {classification}")
            if record.get("completed_at"):
                st.write(f"完了日: {record['completed_at']}")
            rating = record.get("rating")
            if isinstance(rating, int) and 1 <= rating <= 5:
                st.write("★" * rating + "☆" * (5 - rating))
            metric_text = format_metrics(record)
            if metric_text:
                st.write(metric_text)


