def render_list_page() -> None:
    st.title("記録一覧")
    try:
        records = sorted(load_records(), key=lambda record: record.get("completed_at") or "", reverse=True)
    except ValueError as exc:
        st.error(str(exc))
        return

    st.caption(f"記録件数: {len(records)}件")
    if not records:
        st.info("まだ記録がありません。「記録を追加」から登録しましょう")
        return

    confirm_id = st.session_state.get("_confirm_delete_record_id")
    for record in records:
        record_id = str(record.get("id", ""))
        render_record_card(record)
        if confirm_id == record_id:
            st.warning(f"「{record.get('title', 'この記録')}」を削除しますか？")
            confirm_col, cancel_col, _ = st.columns([1, 1, 5])
            with confirm_col:
                if st.button("削除を確定", key=f"confirm_delete_{record_id}", type="primary"):
                    try:
                        delete_record(record_id)
                        st.session_state.pop("_confirm_delete_record_id", None)
                        st.rerun()
                    except ValueError as exc:
                        st.error(str(exc))
            with cancel_col:
                if st.button("キャンセル", key=f"cancel_delete_{record_id}"):
                    st.session_state.pop("_confirm_delete_record_id", None)
                    st.rerun()
        elif st.button("削除", key=f"delete_{record_id}"):
            st.session_state["_confirm_delete_record_id"] = record_id
            st.rerun()


def main() -> None:
    st.set_page_config(page_title="コンテンツ記録", page_icon="📚")
    _ensure_data_file()
    page = st.sidebar.radio("画面", ["ホーム", "記録を追加", "記録一覧"])
    if page == "ホーム":
        st.title("コンテンツ記録")
        st.write("読んだ本や観た作品を記録できます。左のメニューから画面を選んでください。")
        st.metric("記録件数", len(load_records()))
    elif page == "記録を追加":
        render_add_page()
    else:
        render_list_page()


if __name__ == "__main__":
    main()
