# このファイルを同じフォルダに secrets.toml という名前でコピーし、キーを書き込む。
# secrets.toml は .gitignore で除外済み。キーをこの .example や他のファイルに書かないこと。

# TMDB（映画・ドラマ）: 設定 > API の「API Read Access Token」（長い方）
TMDB_API_READ_ACCESS_TOKEN = ""
# 「API Key」（32文字の短い方）しかない場合はこちらでもよい
TMDB_API_KEY = ""

# Annict（アニメ）: 設定 > アプリ > 個人用アクセストークン（スコープは「読み取り専用」でよい）
ANNICT_ACCESS_TOKEN = ""
